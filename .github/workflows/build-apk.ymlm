name: Build Android APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      - name: Unzip & Prepare Project
        run: |
          for z in *.zip; do
            [ -f "$z" ] && unzip -o "$z" -x ".github/*"
          done
          if [ ! -f package.json ]; then
            mkdir -p www
            [ -d iron-fang-fighter ] && cp -r iron-fang-fighter/* www/
            [ -f iron-fang-arcade.html ] && cp iron-fang-arcade.html www/index.html
            printf '{"name":"iron-fang-arcade","version":"1.0.0","private":true,"dependencies":{"@capacitor/android":"^6.1.0","@capacitor/core":"^6.1.0"},"devDependencies":{"@capacitor/cli":"^6.1.0"}}\n' > package.json
            printf '{"appId":"com.ironfang.arcade","appName":"Iron Fang","webDir":"www","android":{"backgroundColor":"#090b14"}}\n' > capacitor.config.json
          fi
      - name: Build Android APK
        run: |
          npm install
          npx cap add android
          python3 -c 'p="android/app/src/main/AndroidManifest.xml"; s=open(p).read(); open(p,"w").write(s.replace("<activity","<activity android:screenOrientation=\"sensorLandscape\"",1)) if "screenOrientation" not in s else None'
          npx cap sync android
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: IronFang-Android-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
